{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/etc/xdg/fastfetch/logo.txt",
        "color": { "1": "white", "2": "yellow" },
        "padding": { "top": 1, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "yellow" }
    },
    "modules": [
        "break",
        "title",
        "separator",
        { "type": "command", "key": "Proxmox", "text": "pveversion | cut -d/ -f2" },
        { "type": "kernel", "key": "Kernel" },
        { "type": "uptime", "key": "Uptime" },
        { "type": "cpu", "key": "CPU" },
        { "type": "memory", "key": "Memory" },
        { "type": "disk", "key": "Disk", "folders": "/:{{ data_mount }}" },
        { "type": "command", "key": "sarten-data", "text": "btrfs device stats -c {{ data_mount }} >/dev/null 2>&1 && echo 'mirror ok' || echo 'mirror ERRORS: btrfs device stats {{ data_mount }}'" },
        { "type": "command", "key": "Guests", "text": "echo \"$(pct list 2>/dev/null | grep -c running) running / $(pct list 2>/dev/null | tail -n +2 | wc -l) containers, $(qm list 2>/dev/null | grep -c running) running / $(qm list 2>/dev/null | tail -n +2 | wc -l) VMs\"" },
        { "type": "localip", "key": "IP", "showIpv6": false },
        "break",
        "colors"
    ]
}
