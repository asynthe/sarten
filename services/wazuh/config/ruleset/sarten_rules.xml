<group name="jellyfin,">
  <rule id="100100" level="0">
    <decoded_as>jellyfin</decoded_as>
    <description>Jellyfin messages grouped.</description>
  </rule>

  <rule id="100101" level="3">
    <if_sid>100100</if_sid>
    <match>has succeeded</match>
    <description>Jellyfin: login succeeded for $(dstuser).</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,</group>
  </rule>

  <rule id="100102" level="5">
    <if_sid>100100</if_sid>
    <match>has been denied</match>
    <description>Jellyfin: login failed for $(dstuser) from $(srcip).</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100103" level="10" frequency="8" timeframe="120">
    <if_matched_sid>100102</if_matched_sid>
    <same_srcip />
    <description>Jellyfin: brute force, 8 failed logins in 2 minutes from $(srcip).</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>
</group>

<group name="honeypot,web,accesslog,">
  <rule id="100110" level="6">
    <if_sid>31100, 31101, 31102, 31108</if_sid>
    <location>/opt/honeypot/logs/access.log</location>
    <description>Honeypot: $(srcip) requested $(url).</description>
  </rule>

  <rule id="100111" level="10" frequency="20" timeframe="60">
    <if_matched_sid>100110</if_matched_sid>
    <same_srcip />
    <description>Honeypot: scan, 20 requests in a minute from $(srcip).</description>
    <mitre>
      <id>T1595</id>
    </mitre>
    <group>recon,</group>
  </rule>
</group>
